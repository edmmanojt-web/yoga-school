// Yoga School — Database Schema
// Version: 1.0.0
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────

enum Role {
  VISITOR
  USER
  TEACHER
  ADMIN
}

enum OfferingCategory {
  YOGA
  BREATHWORK
  MINDFULNESS
  MEDITATION
  JOURNEY
  WORKSHOP
  PROGRAM
  RETREAT
  COMMUNITY
}

enum SessionMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PostVisibility {
  PRIVATE
  COMMUNITY
  PUBLIC
}

enum JourneyStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Language {
  en
  hi
  mr
}

// ─── Auth / User ───────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  phone             String?
  preferredLanguage Language  @default(en)
  role              Role      @default(USER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile           Profile?
  accounts          Account[]
  sessions          AuthSession[]
  bookings          Booking[]
  journeyEnrollments JourneyEnrollment[]
  journeyProgress    JourneyDayProgress[]
  pollResponses      PollResponse[]
  reflections        Reflection[]
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  analyticsEvents    AnalyticsEvent[]
  contactSubmissions ContactSubmission[]

  @@index([email])
  @@index([role])
}

model Profile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  photoUrl String?
  location String?
  timezone String  @default("Asia/Kolkata")
  website  String?

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Offerings ─────────────────────────────────────────────────

model Offering {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  category         OfferingCategory
  shortDescription String
  description      String           @db.Text
  imageUrl         String?
  mode             SessionMode      @default(HYBRID)
  level            String?
  durationMinutes  Int?
  featured         Boolean          @default(false)
  published        Boolean          @default(false)
  sortOrder        Int              @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  sessions         Session[]
  journeys         Journey[]

  @@index([category])
  @@index([published])
  @@index([slug])
}

// ─── Teachers ──────────────────────────────────────────────────

model Teacher {
  id          String    @id @default(cuid())
  userId      String?   @unique
  name        String
  slug        String    @unique
  bio         String    @db.Text
  shortBio    String
  photoUrl    String?
  specialties String[]
  published   Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions    Session[]

  @@index([slug])
}

// ─── Sessions ──────────────────────────────────────────────────

model Session {
  id           String        @id @default(cuid())
  offeringId   String
  teacherId    String?
  title        String
  description  String?       @db.Text
  startTime    DateTime
  endTime      DateTime
  mode         SessionMode   @default(ONLINE)
  capacity     Int           @default(20)
  enrolled     Int           @default(0)
  location     String?
  meetingUrl   String?
  meetingId    String?
  status       SessionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  offering     Offering      @relation(fields: [offeringId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  bookings     Booking[]

  @@index([offeringId])
  @@index([teacherId])
  @@index([startTime])
  @@index([status])
}

// ─── Bookings ──────────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  userId      String
  sessionId   String
  status      BookingStatus @default(PENDING)
  notes       String?
  bookedAt    DateTime      @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session       @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

// ─── Journeys ──────────────────────────────────────────────────

model Journey {
  id          String    @id @default(cuid())
  offeringId  String?
  slug        String    @unique
  title       String
  description String    @db.Text
  subtitle    String?
  imageUrl    String?
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  totalDays   Int       @default(7)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offering    Offering? @relation(fields: [offeringId], references: [id])
  days        JourneyDay[]
  enrollments JourneyEnrollment[]

  @@index([slug])
  @@index([published])
}

model JourneyDay {
  id              String   @id @default(cuid())
  journeyId       String
  dayNumber       Int
  title           String
  subtitle        String?
  theme           String?
  intention       String
  practiceTitle   String
  practiceContent String   @db.Text
  observationNote String   @db.Text
  durationMinutes Int      @default(10)
  imageUrl        String?
  published       Boolean  @default(true)

  journey         Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  polls           Poll[]
  progress        JourneyDayProgress[]
  reflections     Reflection[]

  @@unique([journeyId, dayNumber])
  @@index([journeyId])
}

model JourneyEnrollment {
  id          String        @id @default(cuid())
  userId      String
  journeyId   String
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  status      JourneyStatus @default(ACTIVE)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey     Journey       @relation(fields: [journeyId], references: [id])

  @@unique([userId, journeyId])
  @@index([userId])
  @@index([journeyId])
}

model JourneyDayProgress {
  id          String   @id @default(cuid())
  userId      String
  dayId       String
  completedAt DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         JourneyDay @relation(fields: [dayId], references: [id])

  @@unique([userId, dayId])
  @@index([userId])
  @@index([dayId])
}

// ─── Polls ─────────────────────────────────────────────────────

model Poll {
  id        String       @id @default(cuid())
  dayId     String?
  question  String
  sortOrder Int          @default(0)
  published Boolean      @default(true)

  day       JourneyDay?  @relation(fields: [dayId], references: [id], onDelete: SetNull)
  options   PollOption[]
  responses PollResponse[]

  @@index([dayId])
}

model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  text      String
  sortOrder Int            @default(0)

  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]

  @@index([pollId])
}

model PollResponse {
  id          String     @id @default(cuid())
  userId      String
  pollId      String
  optionId    String
  respondedAt DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll        Poll       @relation(fields: [pollId], references: [id])
  option      PollOption @relation(fields: [optionId], references: [id])

  @@unique([userId, pollId])
  @@index([userId])
  @@index([pollId])
}

// ─── Reflections ───────────────────────────────────────────────

model Reflection {
  id        String      @id @default(cuid())
  userId    String
  dayId     String?
  content   String      @db.Text
  isPrivate Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       JourneyDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dayId])
}

// ─── Community ─────────────────────────────────────────────────

model CommunityPost {
  id         String         @id @default(cuid())
  userId     String
  title      String?
  content    String         @db.Text
  visibility PostVisibility @default(PRIVATE)
  tags       String[]
  reported   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   CommunityComment[]

  @@index([userId])
  @@index([visibility])
  @@index([createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String        @db.Text
  reported  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

// ─── Testimonials ──────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorTitle String?
  content     String   @db.Text
  rating      Int?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// ─── FAQs ──────────────────────────────────────────────────────

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
}

// ─── Contact ───────────────────────────────────────────────────

model ContactSubmission {
  id                String   @id @default(cuid())
  userId            String?
  name              String
  email             String
  phone             String?
  interest          String
  preferredLanguage String?
  message           String   @db.Text
  read              Boolean  @default(false)
  respondedAt       DateTime?
  createdAt         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
  @@index([read])
}

// ─── Analytics ─────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  event      String
  properties Json?
  page       String?
  referrer   String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([userId])
  @@index([createdAt])
}
